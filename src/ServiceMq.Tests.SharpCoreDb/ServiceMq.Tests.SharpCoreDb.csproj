<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net10.0 only: the SharpCoreDB package targets net10.0, so the provider and its tests do
      too. This project is deliberately kept separate from ServiceMq.Tests (net8.0) so the
      .NET 10 requirement stays scoped to this package rather than being imposed repository
      wide through global.json.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- xunit.v3 builds test projects as self-executing apps. -->
    <OutputType>Exe</OutputType>
    <!--
      Run through the VSTest adapter rather than the Microsoft Testing Platform runner so
      "dotnet test" keeps working without a repository-wide global.json opt-in. The .NET 10
      SDK errors out of the VSTest target for MTP applications, which is what
      IsTestingPlatformApplication turns off here.
    -->
    <UseMicrosoftTestingPlatformRunner>false</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>false</TestingPlatformDotnetTestSupport>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServiceMq\ServiceMq.csproj" />
    <ProjectReference Include="..\ServiceMq.SharpCoreDb\ServiceMq.SharpCoreDb.csproj" />
  </ItemGroup>

</Project>
