<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Tyler Jensen</Authors>
    <Company />
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/tylerjensen/ServiceMq</PackageProjectUrl>
    <PackageLicenseFile>License.txt</PackageLicenseFile>
    <Copyright>Tyler Jensen 2013-2026</Copyright>
    <Version>7.4.0</Version>
    <Description>A store and forward message queue for .NET. based on ServiceWire.</Description>
    <PackageTags>Message Queue Messaging Store Forward</PackageTags>
    <PackageReleaseNotes>7.4.0: fixes async receive cancellation losing unreturned messages, preserves acknowledgement visibility leases until completion, restores async storage capacity accounting, and enforces physical disk flushes for durable async file writes and appends. 7.3.0: adds a non-blocking async API. New IAsyncMessageStore interface (implemented by every built-in provider) and async MessageQueue methods: SendAsync, SendBytesAsync, BroadcastAsync, ReceiveAsync, ReceiveBulkAsync, AcceptAsync, AcceptBulkAsync, AcknowledgeAsync, ReEnqueueAsync, GetDeadLettersAsync, ReplayDeadLetterAsync, DeleteDeadLetterAsync, PurgeDeadLettersAsync, GetCorruptEntriesAsync, DeleteCorruptEntryAsync, GetStorageHealthAsync, FlushStorageAsync, and RunStorageMaintenanceAsync. Every async method accepts a CancellationToken and never blocks the caller's thread on storage I/O or the receive wait. The synchronous API is unchanged. 7.2.0: updates Newtonsoft.Json to 13.0.4 and Microsoft.Data.Sqlite to 10.0.12; resolves all SonarCloud high-severity findings (cognitive-complexity refactors, the IDisposable dispose pattern, lock-safety readonly fields, empty-catch documentation, a generic-exception replacement, and redundant-condition cleanups) with no API or behavior changes. Updated to .NET Standard 2.0, .NET 8.0, and ServiceWire 7.0.0. Adds configurable file and memory stores plus the optional ServiceMq.Sqlite provider; durability and capacity policies; atomic portable file persistence; visibility timeouts; dead-letter replay; storage health and maintenance APIs; independent audit retention and payload policies; and optional authenticated AES protection. Existing constructors and legacy queue records remain supported. 7.1.0: adds the optional ServiceMq.SharpCoreDb provider (net10.0) and updates ServiceMq.Sqlite to Microsoft.Data.Sqlite 10.0.11.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="ServiceWire" Version="7.0.0" />
    <InternalsVisibleTo Include="ServiceMq.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\License.txt" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\docs\**\*" Pack="true" PackagePath="docs\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
