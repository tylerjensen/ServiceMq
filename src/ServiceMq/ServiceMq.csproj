<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Tyler Jensen</Authors>
    <Company />
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/tylerjensen/ServiceMq</PackageProjectUrl>
    <PackageLicenseFile>License.txt</PackageLicenseFile>
    <Copyright>Tyler Jensen 2013-2026</Copyright>
    <Version>7.0.0</Version>
    <Description>A store and forward message queue for .NET. based on ServiceWire.</Description>
    <PackageTags>Message Queue Messaging Store Forward</PackageTags>
    <PackageReleaseNotes>Updated to .NET Standard 2.0 and .NET 8.0 and ServiceWire 7.0.0. Bumped version to match ServiceWire version.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="ServiceWire" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\License.txt" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
